# Never send these into the Docker build context — keeps the build fast
# (Docker has to read/hash everything in context before it can start) and
# keeps secrets/bulk files out of any image layer.

node_modules
dist

# Version control
.git
.gitignore

# Docs — irrelevant to the running app
*.md
README.md

# Editor/OS cruft
.vscode
.idea
.DS_Store

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Env files — never bake secrets into an image layer
.env
.env.*
!.env.example
